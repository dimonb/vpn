# VPN Configuration Secrets
# Copy this file to .env and update the values
SALT="XXXX"
OBFS_PASSWORD="AAAA"

# Port Configuration
HTTP_PORT="80"
HTTPS_PORT="443"
HYSTERIA2_PORT="47012"
HYSTERIA2_V2_PORT="47013"
VLESS_PORT="8443"
REALITY_PRIVATE_KEY="your-reality-private-key-here"
REALITY_PUBLIC_KEY="your-reality-public-key-here"
REALITY_SHORT_ID="c047f3e99c90ff71"

# server with config templates
CONFIG_HOST=subs.example.net

# extra hosts serving hand-edited RULE-SET/NETSET lists (comma-separated, optional)
LIST_CACHE_OWN_HOSTS=""

XRAY_MLDSA65SEED=""
XRAY_PRIVATEKEY=""
XRAY_PUBLICKEY=""
XRAY_VERIFY=""

# --- XHTTP entry (optional; empty = off, the templates render as before) ---
# An extra way in, next to the existing stack (sing-box, hysteria, REALITY all stay): VLESS +
# XHTTP on :443 behind caddy, under the host's own name and Let's Encrypt certificate. It is
# served only on hosts that are the `host` of an `xhttp` subscription entry. See AGENTS.md.
# A long random path segment, e.g. `openssl rand -hex 16`; clients must use the same value.
XHTTP_PATH=""
XHTTP_PORT="28480"          # loopback port caddy forwards the path to
XHTTP_MODE=""               # client mode written into subscriptions (packet-up|stream-up|stream-one); empty = client default

# mihomo subscription headers (#CLASH templates); empty = not sent
PROFILE_UPDATE_INTERVAL=""  # hours, e.g. "1"
PROFILE_TITLE=""
