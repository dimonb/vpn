
{% set config = lookup('file', config_file | default('config.json')) | from_json %}
{% set proxy_cfg = (config.get('proxy') if config is mapping else none) %}
{% set host_cfg = (proxy_cfg.get(ansible_host) if proxy_cfg is mapping and proxy_cfg.get(ansible_host) else none) %}
{% set features = (host_cfg.get('features') if host_cfg is mapping else none) %}
{% set forward_group = (features.get('forward-nonru') if features is mapping else none) %}
{% set relay = (forward_group and config.subs.get(forward_group)) %}
services:
  xray:
    # Mirror of ghcr.io/xtls/xray-core:26.2.6 (byte-identical index, same digest).
    # ghcr.io is blocked from Russian networks, docker.io is not — pulling upstream
    # directly makes every RU deploy depend on the sing-box tunnel already being up,
    # which a fresh host does not have. Re-mirror after a version bump: `make mirror-images`.
    image: dimonb/xray-core:26.2.6
    restart: unless-stopped
    volumes:
      - ./xray.json:/etc/xray/config.json:ro
    command: ["run", "-c", "/etc/xray/config.json"]
    ports:
      - "127.0.0.1:28443:28443"
  sing-box:
    image: itdoginfo/sing-box:v1.13.1
    environment:
      - ENABLE_DEPRECATED_MISSING_DOMAIN_RESOLVER=true
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./sing-box.json:/etc/sing-box/config.json
      - ./cert:/etc/xray/certs
  hysteria:
    image: tobyxdd/hysteria
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./cert:/cert
      - ./hysteria.yaml:/etc/hysteria.yaml
    command: ["server", "-c", "/etc/hysteria.yaml"]
  proxy:
    image: dimonb/caddy:latest
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./caddy.json:/etc/caddy/caddy.json
      - ./caddy:/data/
      - ./logs:/logs/
      - ./static:/static/
    command: ["caddy","run","--config","/etc/caddy/caddy.json"]

  # Catawiki json_exporter
  json-exporter:
    image: dimonb/json_exporter:latest
    network_mode: host
    volumes:
      - ./json-exporter.yml:/config.yml:ro
    command: >
      -p 7979
      -l 127.0.0.1
      /config.yml
    restart: unless-stopped
  cfgapp:
    build:
      context: ./cfgapp
      dockerfile: Dockerfile
    restart: unless-stopped
    ports:
      - "127.0.0.1:8003:8000"
    environment:
      - CONFIG_HOST={{ config_host }}
      - PROXY_CONFIG=/config.json
      - OBFS_PASSWORD={{ obfs_password }}
      - HYSTERIA2_PORT={{ hysteria2_port }}
      - HYSTERIA2_V2_PORT={{ hysteria2_v2_port }}
      - VLESS_PORT={{ vless_port }}
      - REALITY_PRIVATE_KEY={{ reality_private_key }}
      - REALITY_PUBLIC_KEY={{ reality_public_key }}
      - REALITY_SHORT_ID={{ reality_short_id }}
      - XRAY_MLDSA65SEED={{ xray_mldsa65seed }}
      - XRAY_PRIVATEKEY={{ xray_privatekey }}
      - XRAY_PUBLICKEY={{ xray_publickey }}
      - XRAY_VERIFY={{ xray_verify }}
      - SALT={{ salt }}
      - IPV4_BLOCK_PREFIX=18
      - IPV6_BLOCK_PREFIX=32
      - HOST=0.0.0.0
      - PORT=8000
      - LOG_LEVEL=INFO
{% if relay %}
      # Origin (CONFIG_HOST) lives outside RU and its IPs are partially blocked
      # from Russian networks — send cfgapp's outbound HTTP through the relay's
      # own sing-box tunnel instead of going direct.
      - HTTP_PROXY=http://cfgapp:{{ ('cfgapp-proxy.' + salt) | hash('sha256') }}@{{ tunnel_proxy_gateway | default('172.29.77.1') }}:{{ tunnel_proxy_port | default(1080) }}
      - HTTPS_PROXY=http://cfgapp:{{ ('cfgapp-proxy.' + salt) | hash('sha256') }}@{{ tunnel_proxy_gateway | default('172.29.77.1') }}:{{ tunnel_proxy_port | default(1080) }}
      - NO_PROXY=localhost,127.0.0.1
{% endif %}
    volumes:
      - ./cfgapp:/app
      - ./config.json:/config.json
{% if relay %}
    networks:
      - default
      - tunnel
{% endif %}
    depends_on:
      - proxy

  node-exporter:
    image: prom/node-exporter:latest
    container_name: node-exporter
    restart: unless-stopped
    command:
      - '--path.procfs=/host/proc'
      - '--path.rootfs=/rootfs'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
      - '--collector.processes'
      - '--collector.systemd'
      - '--collector.tcpstat'
      - '--web.listen-address=127.0.0.1:9100'
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - /var/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
    network_mode: host
    privileged: true
    pid: host
    user: root

{% if relay %}
# Dedicated bridge with a pinned subnet so sing-box (host networking) has a
# stable address to expose its mixed inbound on. Only cfgapp is attached.
networks:
  tunnel:
    name: vpn-tunnel
    ipam:
      config:
        - subnet: {{ tunnel_proxy_subnet | default('172.29.77.0/29') }}
{% endif %}

